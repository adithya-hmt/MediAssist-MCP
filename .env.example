# Server settings
MCP_SERVER_NAME=MediAssist-MCP
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_LOG_LEVEL=INFO

# App mode
MEDIASSIST_ENV=development
MEDIASSIST_MODE=local

# Optional Gemini provider for synthetic-only server-side polishing
ENABLE_GEMINI=false
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_ADVANCED_MODEL=gemini-2.5-pro
GEMINI_MODEL_MODE=balanced
GEMINI_TIMEOUT_SECONDS=20
ALLOW_SYNTHETIC_EXTERNAL_CALLS=false
BLOCK_EXTERNAL_CALLS_ON_PHI=true
PUBLIC_DEMO_MODE=true

# Optional local Ollama helper
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional Streamlit frontend
STREAMLIT_SERVER_PORT=8501
